# Copy this file to .env and fill in your real values. Never commit .env!
DISCORD_TOKEN=your_first_discord_token
DISCORD_TOKEN_2=your_second_discord_token
WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
CHANNEL_IDS=430203025659789343,442709792839172099,1093701764508823622,442709710408515605,1006657687729217647,542147434122444838
# Subset of CHANNEL_IDS that are general/chat channels (e.g. lounge): only check users
# whose message contains a trade-relevant keyword. Defaults to lounge (430203025659789343).
KEYWORD_CHANNEL_IDS=430203025659789343
ROVER_CHANNEL_ID=your_rover_channel_id
ROVER_APP_ID=your_rover_app_id
CLAIM_CHANNEL_ID=your_claim_channel_id
TARGET_GROUP_CHAT_ID=your_target_group_chat_id
AUTOCLAIM_ENABLED=false
AUTOCLAIM_COMMAND_CHANNEL_ID=your_server_channel_id_for_commands
